UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=
UBER_ENV=sandbox
PORT=4000

# Sherpa uses a client_id/client_secret pair (not a single API token) to mint
# a short-lived access token — see server/providers/sherpa.js for details.
# Get these from https://qa.deliveries.sherpa.net.au/users/tokens
SHERPA_CLIENT_ID=
SHERPA_CLIENT_SECRET=
SHERPA_ENV=sandbox

# Storbie order-pull integration ("RoutePoint"). STORBIE_API_ADDRESS is
# per-merchant, e.g. https://medicinesrus.api.mystorbie.com — set it via the
# env var below, don't hardcode it in code.
STORBIE_API_ADDRESS=https://medicinesrus.api.mystorbie.com
STORBIE_KEY_CODE=
STORBIE_SECRET=

# Australia Post / MyPost Business label creation — NOT yet implemented,
# see server/providers/auspost.js. Placeholders only until we have real
# Developer Centre access to confirm the actual API shape.
AUSPOST_CLIENT_ID=
AUSPOST_CLIENT_SECRET=
AUSPOST_ACCOUNT_NUMBER=
AUSPOST_ENV=sandbox

# Australia Post's Postage Assessment Calculator (PAC) + Postcode Search API
# key — see server/integrations/auspostPac.js. This is a DIFFERENT, simpler
# product than the Shipping and Tracking API above: it only estimates
# postage cost and validates postcodes. It CANNOT create a shipping label or
# tracking number. Register at developers.auspost.com.au
# (apis/pacpcs-registration covers both PAC and Postcode Search together).
AUSPOST_PAC_API_KEY=

# Google Maps JavaScript API + Places API key, for address autocomplete on the
# pickup/dropoff/customer address fields. Restrict it in Google Cloud Console
# to just those two APIs (Application restrictions: leave as "None" — HTTP
# referrer restriction doesn't work here, since this app loads index.html via
# file:// in Electron and Chromium sends no Referer header for file:// origins,
# so a referrer restriction would just block every request rather than protect
# anything). The key is served to the frontend via GET /api/config/maps-key
# instead of being hardcoded in index.html, purely to keep it out of the
# git-tracked source file — it's still visible client-side at runtime either
# way, same as any browser-side Maps integration.
GOOGLE_MAPS_API_KEY=

# GoSweetSpot — the actual shipping-label-creation provider, generic across
# whatever carriers are enabled on the account (confirmed today: Aramex,
# CouriersPlease, TNT — Australia Post/MyPost Business is NOT yet confirmed
# available, that's a separate open question with GoSweetSpot support). See
# server/providers/gosweetspot.js. GOSWEETSPOT_SITE_ID is only required if
# the access_key has access to multiple sites — leave blank otherwise.
# IMPORTANT: GoSweetSpot's "sandbox" is a genuinely separate ACCOUNT (signed
# up via ship.gosweetspot.com/opensandbox), not a URL/env flag — there is no
# confirmed separate sandbox hostname, so GOSWEETSPOT_ENV is informational
# only for now. If your key is a real account's key, every shipment/label/
# return call is a real, potentially chargeable action.
GOSWEETSPOT_API_KEY=
GOSWEETSPOT_SITE_ID=
GOSWEETSPOT_ENV=sandbox

# Starshipit — used ONLY for Australia Post / MyPost Business label
# creation for now (see server/providers/starshipit.js). Sherpa/Uber stay
# on their existing providers; consolidating those onto Starshipit is a
# separate, later decision. Confirmed from Starshipit's own docs
# (support.starshipit.com/developers): auth requires BOTH an API key and a
# subscription key, sent as two separate headers (StarShipIT-Api-Key and
# Ocp-Apim-Subscription-Key) — a single key is not enough. Both come from
# Settings > API in the Starshipit dashboard.
# IMPORTANT: Australia Post / MyPost Business must ALSO be linked as a
# courier inside the Starshipit web dashboard first (Settings > Couriers >
# Add New Courier > MyPost Business > Authorise > log into MyPost Business
# > accept terms > enter a payment method) — this is separate from the API
# key and cannot be done via the API. No label will succeed until that's
# done. No sandbox/test mode is documented — this hits real MyPost Business
# with real charges once that linking step is complete.
STARSHIPIT_API_KEY=
STARSHIPIT_SUBSCRIPTION_KEY=
